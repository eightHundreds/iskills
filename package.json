{
  "name": "iskills",
  "version": "0.2.51",
  "description": "Personal Skill collection terminal app for AI coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eightHundreds/iskills.git"
  },
  "homepage": "https://github.com/eightHundreds/iskills#readme",
  "bugs": "https://github.com/eightHundreds/iskills/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "types": "./dist/src/cli.d.ts",
  "bin": {
    "iskills": "./bin/iskills.js"
  },
  "files": [
    "bin",
    "dist/src",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run -s clean && tsc -p tsconfig.build.json",
    "start": "pnpm run -s build && node ./bin/iskills.js",
    "test": "pnpm run -s build && node scripts/test-dev.mjs",
    "test:fast": "pnpm run -s build && bun ./node_modules/vitest/vitest.mjs run --project parallel",
    "test:git": "pnpm run -s build && bun ./node_modules/vitest/vitest.mjs run --project git --project git-sync --project git-write --project git-async",
    "test:tty": "pnpm run -s build && bun ./node_modules/vitest/vitest.mjs run --project tty",
    "type-check": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "jotai": "^2.20.2",
    "json5": "^2.2.3",
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "smol-toml": "^1.8.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@xterm/headless": "^6.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
