{
  "name": "iskills",
  "version": "0.2.27",
  "description": "Personal Skill library CLI for AI coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eightHundreds/iskills.git"
  },
  "homepage": "https://github.com/eightHundreds/iskills#readme",
  "bugs": "https://github.com/eightHundreds/iskills/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/src/cli.d.ts",
  "bin": {
    "iskills": "./bin/iskills.js"
  },
  "files": [
    "bin",
    "dist/src",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean --silent && tsc",
    "start": "npm run build --silent && node ./bin/iskills.js",
    "test": "npm run build --silent && node scripts/test-dev.mjs",
    "test:dev": "npm run build --silent && node scripts/test-dev.mjs",
    "test:fast": "npm run build --silent && vitest run --project parallel",
    "test:git": "npm run build --silent && vitest run --project git",
    "test:tty": "npm run build --silent && vitest run --project tty",
    "type-check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ink": "^6.5.1",
    "jotai": "^2.20.2",
    "react": "^19.2.0",
    "string-width": "^8.2.2",
    "terminal-link": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@xterm/headless": "^6.0.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
